    <None Update="Fixtures/ProHype/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/NflPlayoffLeverage/*.html;Fixtures/NflPlayoffLeverage/*.csv" CopyToOutputDirectory="PreserveNewest" />
