    <None Include="../backend/Migrations/002_TeamRatings.sql" Link="Migrations/002_TeamRatings.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../backend/Migrations/025_TeamRatingSourceSeason.sql" Link="Migrations/025_TeamRatingSourceSeason.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../backend/Migrations/026_PlayoffFinalOutcome.sql" Link="Migrations/026_PlayoffFinalOutcome.sql" CopyToOutputDirectory="PreserveNewest" />
