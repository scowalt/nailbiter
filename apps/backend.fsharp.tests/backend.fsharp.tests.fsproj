<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EspnHttpRequestTests.fs" />
    <Compile Include="F1DataServiceTests.fs" />
    <Compile Include="IndyCarDataServiceTests.fs" />
    <Compile Include="OddsConverterTests.fs" />
    <Compile Include="ModelDeserializationTests.fs" />
    <Compile Include="KalshiServiceTests.fs" />
    <Compile Include="KalshiDoubleheaderTests.fs" />
    <Compile Include="KalshiScheduleChangeTests.fs" />
    <Compile Include="NflPlayoffTests.fs" />
    <Compile Include="NflLowInterestDisplayTests.fs" />
    <Compile Include="PlayoffPolicyTests.fs" />
    <Compile Include="NhlQualificationSelectionTests.fs" />
    <Compile Include="MoneyPuckQualificationPolicyTests.fs" />
    <Compile Include="KalshiPlayoffTests.fs" />
    <Compile Include="HypeScoreTests.fs" />
    <Compile Include="FormatHelpersTests.fs" />
    <Compile Include="LayoutTests.fs" />
    <Compile Include="TeamColorsTests.fs" />
    <Compile Include="ProbabilityDisplayTests.fs" />
    <Compile Include="GameDetailRendererTests.fs" />
    <Compile Include="HighlightsRendererTests.fs" />
    <Compile Include="LogosTests.fs" />
    <Compile Include="LeagueConfigTests.fs" />
    <Compile Include="WorldCupRendererTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/kalshi-*-playoffs-*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/kalshi-mlb-*.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../backend.fsharp/backend.fsharp.fsproj" />
  </ItemGroup>

</Project>
