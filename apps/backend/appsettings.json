{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Extensions.Http.Resilience": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning",
      "backend.Services": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "IncludeScopes": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=excitement_score;Username=postgres;Password=postgres"
  },
  "EnableScraper": true,
  "Highlights": {
    "Worker": {
      "Enabled": false,
      "AuthorizeLaunchCatchup": false,
      "MaxGamesPerCycle": 100,
      "MaxCatchupPages": 16
    },
    "YouTube": {
      "Enabled": false,
      "DailyUnitLimit": 1000,
      "MaxUploadPages": 2
    }
  },
  "PlayoffRatings": {
    "NhlModelMode": "off",
    "NhlModelRefreshEnabled": false,
    "ApprovedSeasons": [],
    "MoneyPuckSelectionEnabled": false,
    "MoneyPuckRefreshEnabled": false,
    "MoneyPuckApprovedSeasons": [],
    "PlayoffStatusCollectionEnabled": true
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": true,
    "TracesSampleRate": 1.0
  },
  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "http://localhost:4317"
  }
}
